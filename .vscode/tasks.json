{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: PowerShell 构建文件扫描器",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                ".vscode/build.ps1",
                "-o",
                "build/file_scanner.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "F:/msys64/ucrt64/bin;F:/msys64/usr/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "通过 PowerShell Unicode 安全地构建全部 C++ 源文件"
        }
    ]
}
